# deploy/env/backend.env 로 복사해 실제 값을 채운다. backend.env 는 git 에 커밋하지 않는다.
# DB_URL / REDIS_HOST / AI_EXTRACTION_BASE_URL / SPRING_PROFILES_ACTIVE 는
# docker-compose.prod.yml 이 내부 네트워크 값으로 주입하므로 여기 두지 않는다.

# --- DB 접속 계정 (mysql.env 의 MYSQL_USER/PASSWORD 와 반드시 일치) ---
DB_USERNAME=gongguhan
DB_PASSWORD=change-this-strong-password

# --- JWT 서명키: 반드시 길고 무작위한 값으로 교체 (예: openssl rand -base64 48) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# --- CORS: 같은 오리진 서빙이라 브라우저엔 사실상 불필요하나, 방어적으로 도메인만 허용 ---
CORS_ALLOWED_ORIGINS=https://j15b205.p.ssafy.io
FRONTEND_BASE_URL=https://j15b205.p.ssafy.io

# --- AWS S3 (상품 이미지 저장소) ---
AWS_S3_BUCKET=gongguhan-product-images-dev
AWS_REGION=ap-northeast-2
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SSAFY 교육용 금융망 apiKey (카드 결제 승인에 필요) ---
SSAFY_API_KEY=

# --- 카카오페이 온라인 단건결제 ---
KAKAOPAY_BASE_URL=https://open-api.kakaopay.com
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=
KAKAOPAY_AUTHORIZATION_SCHEME=SECRET_KEY

# --- 코인 결제(Polygon Amoy 테스트넷). 기본값으로 충분하면 비워둬도 된다 ---
CRYPTO_CHAIN_ID=80002
CRYPTO_RPC_URL=https://rpc-amoy.polygon.technology
