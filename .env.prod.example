# 배포용 환경변수 예시.
# 서버에서 `cp .env.prod.example .env` 후 값을 채우세요. .env 는 git 에 올리지 않습니다.

# ---------- DB ----------
MYSQL_DATABASE=gongguhan
MYSQL_USER=gongguhan
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- 보안 ----------
# 최소 32자 이상의 임의 문자열. 로컬 값과 다르게 두세요.
JWT_SECRET=

# ---------- 서비스 주소 ----------
# 카카오페이 리다이렉트에 쓰입니다. EC2 퍼블릭 주소나 도메인.
FRONTEND_BASE_URL=http://<EC2_PUBLIC_IP>

# ---------- SSAFY 금융망 ----------
SSAFY_API_KEY=

# ---------- 코인 결제 ----------
# 기본값(rpc-amoy.polygon.technology)은 일부 망에서 막힙니다. 반드시 지정하세요.
CRYPTO_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# 환불 지갑 개인키. 이 값을 가진 사람은 그 지갑의 자산을 모두 옮길 수 있습니다.
# 운영에서는 파일 대신 AWS Systems Manager Parameter Store(SecureString) 권장.
CHAIN_REFUND_WALLET_PRIVATE_KEY=

# ---------- 카카오페이 ----------
KAKAOPAY_SECRET_KEY=

# ---------- 선택 ----------
AI_EXTRACTION_BASE_URL=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
