# backend/.env 로 복사해서 실제 값 채우기. .env는 git에 커밋되지 않는다.
AWS_S3_BUCKET=gongguhan-product-images-dev
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SSAFY 교육용 금융망 apiKey. 없으면 카드 결제 승인(S15P21B205-72)이 SSAFY 응답
# 실패(H1008 등)로 끝난다 - createMerchant로 가맹점 등록 후 platform_policies의
# SSAFY_MERCHANT_ID도 함께 채워야 한다.
SSAFY_API_KEY=
