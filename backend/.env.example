# backend/.env 로 복사해서 실제 값 채우기. .env는 git에 커밋되지 않는다.
AWS_S3_BUCKET=gongguhan-product-images-dev
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SSAFY 교육용 금융망 apiKey. 없으면 카드 결제 승인(S15P21B205-72)이 SSAFY 응답
# 실패(H1008 등)로 끝난다. 가맹점(SSAFY_MERCHANT_ID)은 V6 마이그레이션이
# platform_policies에 시드한다 - 재등록·확인은 scripts/ssafy-create-merchant.mjs 참고.
SSAFY_API_KEY=

# AI 상품 이미지 동기 추출 API
AI_EXTRACTION_BASE_URL=http://localhost:8000
AI_EXTRACTION_PATH=/api/v1/products/extract
AI_EXTRACTION_TIMEOUT_MS=10000

# 카카오페이 온라인 단건결제. 실제 Secret Key(dev)는 backend/.env에만 둔다.
KAKAOPAY_BASE_URL=https://open-api.kakaopay.com
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=
KAKAOPAY_AUTHORIZATION_SCHEME=SECRET_KEY
FRONTEND_BASE_URL=http://localhost:5173
KAKAOPAY_TIMEOUT_MS=5000
